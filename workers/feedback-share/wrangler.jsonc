{
  // ログイン無しで誰でも指摘を送れる共有リンク（README.md に手順）。
  // 公開: node scripts/release-tools.mjs wrangler deploy --config workers/feedback-share/wrangler.jsonc
  // 秘密（RATE_LIMIT_SALT）は wrangler secret put で入れる。このファイルにもリポジトリにも書かない。
  "name": "ferret-feedback-share",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // share.ferretade.dev だけで受ける（*.workers.dev では受けない）
  "workers_dev": false,
  "routes": [{ "pattern": "share.ferretade.dev", "custom_domain": true }],
  "vars": {
    "PUBLIC_BASE": "https://share.ferretade.dev"
  },
  // ページの静止画の置き場。公開しないバケット。画像は Worker の /v1/public/<id>/pages/ から返す
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "ferret-share-media" }],
  // 共有1つにつき1つの Durable Object（ShareRoom）と、頻度の上限（FeedbackLimiter。中継と同じもの）。無料のプランで使える SQLite の Durable Object
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "ShareRoom" },
      { "name": "LIMITER", "class_name": "FeedbackLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShareRoom", "FeedbackLimiter"] }],
  // 要求の記録（URL・ヘッダー・IP を含みうる）は残さない。残すのは console.error のエラーの種類だけ
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  "logpush": false
}

# Cloudflare Pages already serves /download for download.html (and redirects download.html to it),
# so only short aliases live here.
/downloads /download 301
/changelog /download#versions 301
/releases /download#versions 301
# /docs/ renders a page and then meta-refreshes, which flashes. Redirect before anything is drawn.
/docs /docs/quick-start 301
/docs/ /docs/quick-start 301
# Same for each docs language (tools/docs/build-docs.mjs writes /docs/<lang>/)
/docs/ja /docs/ja/quick-start 301
/docs/ja/ /docs/ja/quick-start 301
# Languages dropped in 0.6.14 (only English and Japanese now): send old links to the English page
/docs/zh-CN /docs/quick-start 301
/docs/zh-CN/* /docs/:splat 301
/docs/zh-TW /docs/quick-start 301
/docs/zh-TW/* /docs/:splat 301
/docs/ko /docs/quick-start 301
/docs/ko/* /docs/:splat 301
/docs/es /docs/quick-start 301
/docs/es/* /docs/:splat 301
